# Hugging Face Token (required for gated models like Llama Guard)
HF_TOKEN=your_hugging_face_token_here

# Google Sign-In (required)
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:5173 as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Secret used to sign session tokens. Must be at least 32 bytes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=your_random_session_secret_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Feature Flags
USE_MOCK_LLMS=true
ENABLE_FALLBACK=true
ENABLE_SAFETY_VALIDATION=false

# Logging
LOG_LEVEL=INFO
LOG_RAW_QUERIES=false

# Model Configuration
DEVICE_MAP=auto
LOAD_IN_8BIT=true